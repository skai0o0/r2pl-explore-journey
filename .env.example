# Server-only deployment values. Replace database and admin credentials for Production.
# play:schools remains a synthetic loopback launcher; these local defaults are disposable.
DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
PORT=4176
WS_PORT=2568
ADMIN_KEY=dev-map-admin
# Production example: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Production ADMIN_KEY must be a private deployment secret, never dev-map-admin.

# Set BOTH to select HttpCampaignProvider; blank selects SyntheticCampaignProvider.
# API must implement POST sessions/verify and GET running/:externalStudentId (README_PLAY.md).
CAMPAIGN_API_URL=
CAMPAIGN_SHARED_SECRET=

# Explicit local/dev fixture opt-in. Production authentication is not seeded by this launcher.
R2PL_BOT_SIMULATION=1
R2PL_BOT_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
# Never run test/gate scripts against a production database.
R2PL_PREPARATION_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
R2PL_TEST_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
R2PL_LOADTEST_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
