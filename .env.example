# =============================================================================
# R2PL Game V2 — Environment Configuration Template (.env.example)
# =============================================================================

# PostgreSQL database connection for play:schools server daemon
R2PL_BOT_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current

# PostgreSQL connection for preparation / test suite execution
R2PL_PREPARATION_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
R2PL_TEST_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current

# PostgreSQL connection for 500-client load test gate (npm run test:load500)
R2PL_LOADTEST_DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current

# Admin Secret Key for Map Editor and Gift Check-in Verifier
ADMIN_KEY=dev-map-admin

# Bot simulation toggle (1 = spawn background synthetic explorers, 0 = standalone player server)
R2PL_BOT_SIMULATION=1

# Web & WebSocket server ports (default: 4176 HTTP, 2568 WebSocket)
PORT=4176
WS_PORT=2568

# 3D Asset Auto-Loader Conventions:
# - HQs:        client/public/models/hqs/<schoolId>_hq.glb (e.g., hcmut_hq.glb, hcmiu_hq.glb)
# - Landmarks:  client/public/models/landmarks/<landmarkId>.glb (e.g., fansipan.glb, halong.glb)
# - UniStops:   client/public/models/unistops/unistop_<tier>.glb (aspire, nitro, predator)
# - Chests:     client/public/models/chests/chest_<tier>.glb (aspire, nitro, predator)
# - Draco:      client/public/draco/
