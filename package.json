{
  "name": "r2pl-game-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check shared server client tests scripts",
    "format": "biome check --write shared server client tests scripts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:client": "vite build client --outDir ../dist/client --emptyOutDir",
    "build": "npm run typecheck && npm run build:client",
    "bench:world": "node --expose-gc --experimental-strip-types scripts/bench-world.ts",
    "bench:realtime": "node --experimental-strip-types scripts/bench-realtime.ts",
    "migrate:m3": "node --experimental-strip-types scripts/migrate-m3.ts",
    "migrate:m35": "node --experimental-strip-types scripts/migrate-m35.ts",
    "bench:postgres": "node --experimental-strip-types scripts/bench-postgres.ts",
    "play:local": "npm run build:client && node --experimental-strip-types scripts/play-local.ts",
    "report:size": "node scripts/report-size.mjs",
    "test:preparation": "node --experimental-strip-types --test --test-concurrency=1 tests/integration-preparation.test.ts tests/running-preparation-postgres.test.ts tests/reward-preparation-contract.test.ts tests/reward-preparation-postgres.test.ts",
    "test:postgres": "node --experimental-strip-types scripts/test-postgres.ts",
    "test:rewards": "node --experimental-strip-types --test --test-concurrency=1 tests/reward-preparation-contract.test.ts tests/reward-preparation-postgres.test.ts",
    "demo:rewards": "node --experimental-strip-types scripts/demo-rewards.ts"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "pg": "8.23.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
