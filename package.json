{
  "name": "r2pl-game-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check shared server client tests scripts",
    "format": "biome check --write shared server client tests scripts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:client": "vite build client --outDir ../dist/client --emptyOutDir",
    "build": "npm run typecheck && npm run build:client",
    "bench:world": "node --expose-gc --experimental-strip-types scripts/bench-world.ts",
    "bench:realtime": "node --experimental-strip-types scripts/bench-realtime.ts",
    "report:size": "node scripts/report-size.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
