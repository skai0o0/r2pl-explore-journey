# Copy to .env.portal, keep credentials server-side. This file contains NO real secret.
# Staging runs on loopback. Production requires PUBLIC_ORIGIN/PORTAL_LOGIN_URL HTTPS
# and PUBLIC_WEBSOCKET_URL WSS, with a reverse proxy for HTTP and Colyseus.
PORTAL_MODE=staging
PORTAL_CAMPAIGN_ID=99000000-0000-4000-8000-000000000001
PUBLIC_ORIGIN=http://127.0.0.1:4176
PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:2568
PORTAL_LOGIN_URL=http://127.0.0.1:4180/login
PORT=4176
WS_PORT=2568
# migrate:portal verifies/applies migrations 1–6. A distinct portal campaign is seeded.
DATABASE_URL=postgresql://prep_fixture@127.0.0.1:55439/r2pl_prep_test_current
# Replace both placeholders with independently generated secrets of at least 32 bytes.
PORTAL_KEYS_JSON={"partner-2026-01":"REPLACE_WITH_RANDOM_PARTNER_SECRET"}
ADMIN_KEY=REPLACE_WITH_DIFFERENT_RANDOM_ADMIN_SECRET
