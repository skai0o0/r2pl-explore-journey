[Unit]
Description=R2PL Sandbox Game (paired with Student Sandbox Portal)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/r2pl-game
Environment=NODE_ENV=production
Environment=PORT=4191
Environment=WS_PORT=2569
Environment=R2PL_BOT_SIMULATION=1
Environment=R2PL_BOT_DATABASE_URL=postgres://r2pl_user:r2pl_secure_pass_2026@127.0.0.1:5432/r2pl_bot_test_standalone
Environment=PUBLIC_WEBSOCKET_URL=wss://play.skai0o0.id.vn
Environment=ENABLE_BOTS=0
ExecStart=/usr/bin/node --experimental-strip-types scripts/play-schools.ts
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
